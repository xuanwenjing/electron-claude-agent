# Anthropic 官方 API Key，或兼容网关凭证
ANTHROPIC_API_KEY=
# 可选：走兼容网关时填写
# ANTHROPIC_BASE_URL=https://your-gateway.example.com
# ANTHROPIC_AUTH_TOKEN=

# 可选：扩展远程更新地址，返回 { "version": "0.1.1", "url": "https://.../chrome-extension.zip" }
# EXT_UPDATE_URL=https://your-server.example.com/ext-latest.json

# 可选：模型名
# ANTHROPIC_MODEL=claude-sonnet-4-5

# 客户端登录及业务 API（本地 mock 默认端口 3000，不需要追加 /api）
CLIENT_API_BASE_URL=http://localhost:3000
