{
  "manifest_version": 3,
  "name": "Crawl Bridge Extension",
  "version": "0.1.4",
  "description": "执行 Electron 下发的通用抓取 workflow",
  "permissions": ["tabs", "windows", "scripting", "storage", "alarms", "debugger", "webNavigation", "cookies"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background/index.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["page/networkInterceptor.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["content/index.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "Crawl Bridge",
    "default_popup": "popup/popup.html"
  }
}
