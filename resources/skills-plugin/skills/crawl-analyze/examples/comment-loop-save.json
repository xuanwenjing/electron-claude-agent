{
  "maxRetry": 1,
  "workflow": [
    {
      "type": "navigate",
      "url": "https://ebooking.ctrip.com/comment/commentList",
      "event": "listcap",
      "need_collect": true,
      "reg_exp": "getCommentList",
      "global_variables": [
        {
          "name": "listHit",
          "url": "getCommentList"
        }
      ]
    },
    {
      "type": "loop",
      "max_count": "${listHit.response.pageCount || 20}",
      "loop_index_var": "_page",
      "break_condition": "${(listHit.response.commentlist || []).length == 0 || listHit.response.currentPageIndex >= listHit.response.pageCount}",
      "children": [
        {
          "type": "call_api",
          "event": "comment_page",
          "need_collect": true,
          "reg_exp": "getCommentList",
          "global_variables": {
            "name": "listHit",
            "url": "getCommentList"
          },
          "call_api_params": {
            "url": "https://ebooking.ctrip.com/restapi/soa2/26353/getCommentList",
            "method": "POST",
            "headers": {
              "__ref": "${listHit.headers}"
            },
            "payload": {
              "__ref": "${listHit.payload}",
              "catalogTab": "NotFeedBack",
              "pageIndex": "${_page + 1}"
            }
          }
        },
        {
          "type": "loop",
          "max_count": "${(listHit.response.commentlist || []).length}",
          "loop_index_var": "_i",
          "children": [
            {
              "type": "call_api",
              "event": "detail",
              "need_collect": true,
              "reg_exp": "getCommentDetail",
              "global_variables": {
                "name": "detailHit",
                "url": "getCommentDetail"
              },
              "call_api_params": {
                "url": "https://ebooking.ctrip.com/restapi/soa2/26353/getCommentDetail",
                "method": "POST",
                "headers": {
                  "__ref": "${listHit.headers}"
                },
                "payload": {
                  "__ref": "${listHit.payload}",
                  "commentId": "${listHit.response.commentlist[_i].commentId}"
                }
              }
            },
            {
              "type": "call_backend",
              "event": "save_comment",
              "call_backend_params": {
                "url": "/client/comment/save",
                "method": "POST",
                "data": {
                  "comment_id": "${listHit.response.commentlist[_i].commentId}",
                  "detail": "${detailHit.response}"
                }
              }
            }
          ]
        }
      ]
    }
  ]
}
