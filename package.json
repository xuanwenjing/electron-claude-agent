{
  "name": "electron-claude-agent",
  "version": "0.1.3",
  "private": true,
  "description": "Electron + Claude Agent SDK：窗口点按钮跑通 query（Skill / Bash），支持 macOS & Windows 打包",
  "main": "dist/main/index.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/xuanwenjing/electron-claude-agent.git"
  },
  "author": "xuanwenjing",
  "scripts": {
    "postinstall": "node scripts/ensure-electron.js && npm run rebuild:native",
    "rebuild:native": "electron-rebuild -f -w better-sqlite3",
    "python:fetch": "node scripts/fetch-python.js",
    "dev": "npm run python:fetch && npm run build:ts && npm run renderer:build && npm run ext:build && concurrently -k \"tsc -p tsconfig.json --watch --preserveWatchOutput\" \"vite build --watch --config src/renderer/vite.config.mts\" \"wait-on dist/main/index.js dist/renderer/index.html && npm run start:electron\"",
    "build:ts": "tsc -p tsconfig.json",
    "renderer:build": "vite build --config src/renderer/vite.config.mts",
    "renderer:typecheck": "tsc -p src/renderer/tsconfig.json --noEmit",
    "ext:build": "node chrome-extension/build.mjs",
    "ext:watch": "node chrome-extension/build.mjs --watch",
    "ext:typecheck": "tsc -p chrome-extension/tsconfig.json --noEmit",
    "build": "node scripts/fetch-python.js current win-x64 && npm run build:ts && npm run renderer:build && npm run ext:build && npm run rebuild:native && electron-builder --mac --win",
    "build:mac": "node scripts/fetch-python.js current && npm run build:ts && npm run renderer:build && npm run ext:build && npm run rebuild:native && electron-builder --mac",
    "build:win": "node scripts/fetch-python.js win-x64 && npm run build:ts && npm run renderer:build && npm run ext:build && npm run rebuild:native && electron-builder --win",
    "release:mac": "node scripts/fetch-python.js current && npm run build:ts && npm run renderer:build && npm run ext:build && npm run rebuild:native && electron-builder --mac --publish always",
    "start": "npm run python:fetch && npm run build:ts && npm run renderer:build && npm run ext:build && npm run start:electron",
    "start:electron": "node scripts/run-electron.js ."
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.220",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "adm-zip": "^0.6.1",
    "better-sqlite3": "^13.0.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.45.2",
    "electron-updater": "^6.8.9",
    "lucide-react": "^1.28.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0",
    "ws": "^8.21.1",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/adm-zip": "^0.5.8",
    "@types/better-sqlite3": "^7.6.13",
    "@types/chrome": "^0.2.5",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.0.5",
    "concurrently": "^9.1.2",
    "electron": "^37.2.3",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.28.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.2",
    "vite": "^8.2.0",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.example.electron-claude-agent",
    "productName": "ElectronClaudeAgent",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/skills-plugin",
        "to": "skills-plugin"
      },
      {
        "from": "workspace",
        "to": "workspace"
      },
      {
        "from": "chrome-extension/dist",
        "to": "chrome-extension"
      },
      {
        "from": "resources/python/${os}-${arch}",
        "to": "python",
        "filter": [
          "**/*",
          "!.requirements",
          "!.version"
        ]
      }
    ],
    "asar": true,
    "asarUnpack": [
      "**/node_modules/@anthropic-ai/claude-agent-sdk*/**",
      "**/node_modules/better-sqlite3/**"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "xuanwenjing",
        "repo": "electron-claude-agent",
        "releaseType": "release"
      }
    ]
  }
}
